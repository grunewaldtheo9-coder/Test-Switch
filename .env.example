# ─────────────────────────────────────────────
#  ARIA — Environment Variables (example)
#  Copy to .env and fill in your values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# App
APP_NAME=ARIA
APP_VERSION=1.0.0
LOG_LEVEL=info
MAX_LOG_DAYS=90
BACKUP_PATH=~/ARIA_Backups

# Security
ENCRYPTION_KEY_DERIVATION=pbkdf2
SESSION_TIMEOUT_MINUTES=480
PIN_REQUIRED_LEVEL=4

# Limits
MAX_EMAIL_BATCH=50
MAX_FILE_SCAN_MB=500
AUTO_PAYMENT_LIMIT=0
