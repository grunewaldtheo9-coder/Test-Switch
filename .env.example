# ─────────────────────────────────────────────
#  ARIA — Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────

# Google Gemini (free tier — get your key at aistudio.google.com)
# The default key below is already embedded in the app for convenience.
GEMINI_API_KEY=AIzaSyAM4k_tgGradQQ3mDIGyBgJoKl6jzKt8jU

# Google OAuth (for Gmail / Google Calendar integration — desktop only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (for Outlook — desktop only)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# App
APP_NAME=ARIA
APP_VERSION=1.0.0
LOG_LEVEL=info
MAX_LOG_DAYS=90
BACKUP_PATH=~/ARIA_Backups

# Security
SESSION_TIMEOUT_MINUTES=480
PIN_REQUIRED_LEVEL=4

# Limits
MAX_EMAIL_BATCH=50
AUTO_PAYMENT_LIMIT=0
