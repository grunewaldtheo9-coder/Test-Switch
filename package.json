{
  "name": "aria-agent",
  "version": "1.0.0",
  "description": "ARIA — Autonomous Resident Intelligence Agent",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "dev:renderer": "vite",
    "dev:main": "electron .",
    "build": "vite build && electron-builder",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "android:init": "npx cap init \"ARIA Agent\" com.aria.agent --web-dir dist",
    "android:add": "npx cap add android",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && npx cap build android",
    "android:run": "vite build && npx cap sync android && npx cap run android"
  },
  "keywords": ["aria", "ai", "agent", "gemini", "android", "electron"],
  "author": "ARIA Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "better-sqlite3": "^9.4.3",
    "node-cron": "^3.0.3",
    "keytar": "^7.9.0",
    "nodemailer": "^6.9.13",
    "imap": "^0.8.19",
    "googleapis": "^140.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^5.1.0",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "electron-store": "^8.2.0",
    "winston": "^3.13.0",
    "crypto-js": "^4.2.0",
    "chokidar": "^3.6.0",
    "systeminformation": "^5.22.10",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "@capacitor/cli": "^6.1.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.5.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.395.0",
    "recharts": "^2.12.7",
    "clsx": "^2.1.1"
  },
  "build": {
    "appId": "com.aria.agent",
    "productName": "ARIA Agent",
    "directories": { "output": "dist-electron" },
    "files": ["src/main/**/*", "dist/**/*"],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
